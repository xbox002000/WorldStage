{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "period": {
          "type": "string"
        },
        "quote": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "EvidenceSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "period": {
          "type": "string"
        },
        "reliability": {
          "type": "number"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "type": "object"
    },
    "PersonaClaim": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "type": "number"
        },
        "contradicts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "type": "array"
        },
        "field": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "stated",
            "inferred",
            "authored"
          ]
        },
        "statement": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "field",
        "statement",
        "kind"
      ],
      "type": "object"
    },
    "PersonaEvidence": {
      "additionalProperties": false,
      "properties": {
        "claims": {
          "items": {
            "$ref": "#/$defs/PersonaClaim"
          },
          "type": "array"
        },
        "genome_id": {
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/EvidenceSource"
          },
          "type": "array"
        },
        "version": {
          "type": "integer"
        }
      },
      "required": [
        "genome_id"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/PersonaEvidence",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
